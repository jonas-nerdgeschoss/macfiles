#!/usr/bin/env bash

set -e

# Select the directory to open in a (new) tmux session
if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(
        (
            echo "$HOME"
            echo "$HOME/code"
            find -L "$HOME/code" -mindepth 1 -maxdepth 1 -type d | sort
            echo "$HOME/.macfiles"
        ) | fzf --cycle --print-query | tail -1
    )
fi

# Exit if no directory was selected
if [[ -z $selected ]]; then
    exit 0
fi

# Try to clone a directory from GitHub if no match was found
if [[ ! -d "$selected" ]]; then
    scdj "$selected"
    exit 0
fi

# Generate a session name based on the selected directory
if [[ $selected == "$HOME/code"* ]]; then
    session_name=$(echo $selected | sed -e "s|$HOME/code/||")
else
    session_name=$(basename $selected)
fi
session_name=$(echo $session_name | tr . _)

# (Create and) attach/switch to the session
if ! tmux has-session -t=$session_name 2> /dev/null; then
    tmux new-session -ds $session_name -n $session_name -c $selected -e TMUX_SESSIONIZER_ROOT_DIRECTORY=$selected
fi
if [[ -n $TMUX ]]; then
    tmux switch-client -t $session_name
else
    exec tmux attach -t $session_name
fi
