#!/bin/bash

# scdj - source code detective Jonas

set -e

selected=$(
    gh search repos $* --json fullName,name,description,updatedAt,stargazersCount --template \
    '{{tablerow "Name" "Directory Name" "Description" "Updated" "Stars"}}{{range .}}{{tablerow .fullName .name .description (timeago .updatedAt) .stargazersCount}}{{end}}' \
    | fzf --cycle --header-lines 1
)

repository=$(echo "$selected" | awk '{print $1;}')
directory=$(echo "$selected" | awk '{print $2;}')
cloned_path="$HOME/code/$directory"

if [[ ! -d "$cloned_path" ]]; then
    gh repo clone "$repository" "$cloned_path"
fi

tmux-sessionizer "$cloned_path"
